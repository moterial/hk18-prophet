# ============================================================
# HK18 Prophet — Environment Configuration
# ============================================================

# LLM API Configuration (any OpenAI SDK-compatible endpoint)
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   Anthropic:  https://api.anthropic.com/v1  (with adapter)
#   Ollama:     http://localhost:11434/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Simulation Settings
SIMULATION_ROUNDS=3
MAX_CONCURRENT_AGENTS=10
DELAY_BETWEEN_AGENTS=1000

# Server
PORT=5001
NODE_ENV=development

# Cache TTL (hours) — how long district/estate reports stay valid
# Use 1 for dev, 24 for production
CACHE_TTL_HOURS=1

# Rate Limiting — max LLM-consuming requests per IP per hour
RATE_LIMIT_CUSTOM_PER_HOUR=10
RATE_LIMIT_DISTRICT_PER_HOUR=30

# CORS — allowed origins (comma-separated), empty = allow all
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# News API (optional — for live news sentiment)
# Get a free key at https://newsapi.org/
NEWS_API_KEY=

# Database (JSON file-based, auto-created)
DB_PATH=./data/hk18prophet.db
