.dashboard-layout {
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 0;
  min-height: calc(100vh - 70px);
}

/* ── Map Panel ── */
.map-panel {
  background: #0d1117;
  border-right: 1px solid #30363d;
  padding: 20px;
  overflow-y: auto;
  max-height: calc(100vh - 70px);
}

.map-panel h2 { margin-bottom: 4px; font-size: 1.1rem; color: #f0f6fc; }
.map-hint { font-size: 0.8rem; color: #8b949e; margin-bottom: 12px; }

.district-list { margin-top: 16px; }
.region-group { margin-bottom: 12px; }
.region-name { font-size: 0.7rem; color: #484f58; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; margin-bottom: 6px; }
.region-districts { display: flex; flex-wrap: wrap; gap: 6px; }

.district-btn {
  background: #161b22; border: 1px solid #30363d; border-radius: 6px;
  padding: 6px 10px; cursor: pointer; display: flex; align-items: center;
  gap: 6px; transition: all 0.15s; color: #e1e4e8;
}
.district-btn:hover { border-color: #58a6ff; background: #1c2333; }
.district-btn.selected { border-color: #58a6ff; background: #1a3a5c; }
.district-btn.loading { animation: btn-pulse 1.5s ease-in-out infinite; }

@keyframes btn-pulse {
  0%, 100% { background: #161b22; } 50% { background: #1c2d44; }
}

.district-btn.analyzed.dir-up { border-color: #3fb950; }
.district-btn.analyzed.dir-down { border-color: #f85149; }
.district-btn.analyzed.dir-stable { border-color: #58a6ff; }

.btn-cn { font-size: 0.85rem; font-weight: 600; }
.btn-en { font-size: 0.7rem; color: #8b949e; }
.btn-dir { font-size: 0.8rem; }

/* ── Detail Panel ── */
.detail-panel { padding: 24px 32px; overflow-y: auto; max-height: calc(100vh - 70px); }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; height: 60vh; text-align: center; color: #8b949e;
}
.empty-icon { font-size: 4rem; margin-bottom: 16px; }
.empty-state h3 { color: #f0f6fc; margin-bottom: 8px; }
.empty-state .hint { font-size: 0.85rem; color: #484f58; margin-top: 8px; }

.loading-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; height: 60vh; text-align: center;
}

.loading-spinner {
  width: 48px; height: 48px; border: 3px solid #30363d;
  border-top: 3px solid #58a6ff; border-radius: 50%;
  animation: spin 1s linear infinite; margin-bottom: 16px;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-state h3 { color: #f0f6fc; margin-bottom: 16px; }
.loading-status { max-width: 320px; width: 100%; }
.status-line { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 0.85rem; }
.status-line .label { color: #8b949e; }
.status-line .value { color: #e1e4e8; font-weight: 600; }
.progress-bar { height: 6px; background: #21262d; border-radius: 3px; overflow: hidden; margin-top: 8px; }
.progress-fill { height: 100%; background: #58a6ff; border-radius: 3px; transition: width 0.5s ease; }

/* ── Result ── */
.district-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 12px; }
.dh-left h2 { font-size: 1.4rem; color: #f0f6fc; margin-bottom: 4px; }
.district-code-badge { background: #21262d; border: 1px solid #30363d; border-radius: 4px; padding: 2px 8px; font-size: 0.75rem; color: #8b949e; font-weight: 600; }
.dh-right { display: flex; gap: 8px; align-items: center; }
.direction-badge { padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; }

.dir-up { background: rgba(63,185,80,0.15); color: #3fb950; border: 1px solid #3fb950; }
.dir-down { background: rgba(248,81,73,0.15); color: #f85149; border: 1px solid #f85149; }
.dir-stable { background: rgba(88,166,255,0.15); color: #58a6ff; border: 1px solid #58a6ff; }
.dir-mixed { background: rgba(210,153,34,0.15); color: #d29922; border: 1px solid #d29922; }

.confidence-badge { font-size: 0.8rem; color: #8b949e; }

.summary-box {
  background: #161b22; border: 1px solid #30363d; border-radius: 8px;
  padding: 16px; margin-bottom: 20px; color: #c9d1d9; line-height: 1.6;
}

.predictions-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 24px; }
.pred-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px; text-align: center; }
.pred-label { font-size: 0.75rem; color: #8b949e; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
.pred-change { font-size: 1.6rem; font-weight: 800; margin-bottom: 4px; }
.change-up { color: #3fb950; }
.change-down { color: #f85149; }
.change-stable { color: #58a6ff; }
.pred-range { font-size: 0.75rem; color: #58a6ff; margin-bottom: 6px; }
.pred-narrative { font-size: 0.8rem; color: #8b949e; line-height: 1.4; }

.section-title { font-size: 1.05rem; color: #f0f6fc; margin-bottom: 12px; }

.estates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; margin-bottom: 24px; }
.estate-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 14px; }
.estate-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
.estate-header strong { color: #f0f6fc; font-size: 0.95rem; }
.estate-en { color: #8b949e; font-size: 0.8rem; margin-left: 4px; }
.rec-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 2px 8px; border-radius: 4px; white-space: nowrap; }
.rec-buy { background: rgba(63,185,80,0.15); color: #3fb950; }
.rec-hold { background: rgba(88,166,255,0.15); color: #58a6ff; }
.rec-wait { background: rgba(210,153,34,0.15); color: #d29922; }
.estate-area { font-size: 0.8rem; color: #8b949e; margin-bottom: 4px; }
.estate-price { font-size: 0.85rem; color: #c9d1d9; margin-bottom: 8px; }
.estate-preds { display: flex; gap: 10px; margin-bottom: 8px; }
.estate-pred { font-size: 0.8rem; font-weight: 700; }
.estate-factors { display: flex; flex-wrap: wrap; gap: 4px; }
.factor-tag { background: #21262d; border-radius: 4px; padding: 1px 6px; font-size: 0.7rem; color: #8b949e; }

.news-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
.news-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 14px; border-left: 3px solid #30363d; }
.news-card.news-positive { border-left-color: #3fb950; }
.news-card.news-negative { border-left-color: #f85149; }
.news-card.news-neutral { border-left-color: #d29922; }
.news-header { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 6px; }
.news-header strong { color: #f0f6fc; font-size: 0.9rem; }
.news-meta { display: flex; gap: 16px; font-size: 0.75rem; color: #8b949e; margin-bottom: 6px; }
.news-impact { font-size: 0.85rem; color: #c9d1d9; line-height: 1.4; }

.ro-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
.ro-box { background: #161b22; border-radius: 8px; padding: 14px; }
.ro-box h4 { margin-bottom: 8px; font-size: 0.9rem; }
.ro-box ul { list-style: none; padding: 0; }
.ro-box li { padding: 3px 0; font-size: 0.85rem; color: #c9d1d9; }
.ro-box li::before { content: '•'; margin-right: 8px; }
.opp-box { border: 1px solid #238636; }
.risk-box { border: 1px solid #f85149; }

.btn-primary, .btn-reanalyze {
  background: #238636; color: #fff; border: none; border-radius: 6px;
  padding: 10px 24px; font-size: 0.9rem; font-weight: 600; cursor: pointer;
}
.btn-primary:hover, .btn-reanalyze:hover { background: #2ea043; }
