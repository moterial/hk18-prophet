# ============================================================
# HK18 Prophet — Environment Configuration
# ============================================================

# LLM API Configuration (any OpenAI SDK-compatible endpoint)
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   Anthropic:  https://api.anthropic.com/v1  (with adapter)
#   Ollama:     http://localhost:11434/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Simulation Settings
SIMULATION_ROUNDS=5
MAX_CONCURRENT_AGENTS=10

# Server
PORT=5001
NODE_ENV=development

# News API (optional — for live news sentiment)
# Get a free key at https://newsapi.org/
NEWS_API_KEY=

# Database (SQLite, auto-created)
DB_PATH=./data/hk18prophet.db
