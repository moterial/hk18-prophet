<template>
  <div class="dashboard">
    <div class="dashboard-layout">
      <!-- Left: Map -->
      <div class="map-panel">
        <h2>🗺️ Hong Kong 18 Districts</h2>
        <p class="map-hint">Click a district to start AI analysis</p>
        <HKMap
          :districts="districts"
          :selectedCode="selectedDistrict"
          :analyzedDistricts="analyzedDistricts"
          :loadingDistrict="loadingDistrict"
          @select="onDistrictSelect"
        />
        <!-- District list below map -->
        <div class="district-list">
          <div
            v-for="d in districtsByRegion"
            :key="d.region"
            class="region-group"
          >
            <div class="region-name">{{ d.region }}</div>
            <div class="region-districts">
              <button
                v-for="dist in d.districts"
                :key="dist.code"
                :class="districtBtnClass(dist.code)"
                @click="onDistrictSelect(dist.code)"
              >
                <span class="btn-cn">{{ dist.nameCn }}</span>
                <span class="btn-en">{{ dist.code }}</span>
                <span v-if="analyzedDistricts[dist.code]" class="btn-dir">
                  {{ directionEmoji(analyzedDistricts[dist.code].direction) }}
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Detail Panel -->
      <div class="detail-panel">
        <!-- Empty state -->
        <div v-if="!selectedDistrict && !loadingDistrict" class="empty-state">
          <div class="empty-icon">🏠</div>
          <h3>Select a District</h3>
          <p>Click any district on the map to start an AI-powered prediction analysis for that area.</p>
          <p class="hint">Each analysis uses 8 specialized AI agents to generate predictions for major housing estates (屋苑).</p>
        </div>

        <!-- Loading state -->
        <div v-if="loadingDistrict" class="loading-state">
          <div class="loading-spinner"></div>
          <h3>Analyzing {{ getDistrictName(loadingDistrict) }}</h3>
          <div v-if="currentStatus" class="loading-status">
            <div class="status-line">
              <span class="label">Phase</span>
              <span class="value">{{ currentStatus.currentPhase }}</span>
            </div>
            <div class="status-line">
              <span class="label">Agents</span>
              <span class="value">{{ currentStatus.agentsCompleted }} / {{ currentStatus.totalAgents }}</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" :style="{ width: progressPercent + '%' }"></div>
            </div>
          </div>
        </div>

        <!-- Result state -->
        <div v-if="selectedDistrict && !loadingDistrict && selectedReport" class="result-state">
          <!-- District header -->
          <div class="district-header">
            <div class="dh-left">
              <h2>{{ selectedReport.districtNameCn || getDistrictNameCn(selectedDistrict) }} {{ selectedReport.districtName || getDistrictName(selectedDistrict) }}</h2>
              <span class="district-code-badge">{{ selectedDistrict }}</span>
            </div>
            <div class="dh-right">
              <span class="direction-badge" :class="'dir-' + selectedReport.direction">
                {{ directionEmoji(selectedReport.direction) }} {{ selectedReport.direction?.toUpperCase() }}
              </span>
              <span class="confidence-badge">{{ ((selectedReport.confidence || 0) * 100).toFixed(0) }}% confidence</span>
            </div>
          </div>

          <!-- Summary -->
          <div class="summary-box">
            <p>{{ selectedReport.summary }}</p>
          </div>

          <!-- Price predictions: 1yr, 5yr, 10yr -->
          <div class="predictions-row">
            <div class="pred-card" v-for="(p, key) in selectedReport.predictions" :key="key">
              <div class="pred-label">{{ formatPeriod(key) }}</div>
              <div class="pred-change" :class="changeClass(p.change)">{{ p.change }}</div>
              <div class="pred-range" v-if="p.priceRange">
                ${{ p.priceRange[0]?.toLocaleString() }} – ${{ p.priceRange[1]?.toLocaleString() }}/sqft
              </div>
              <div class="pred-narrative">{{ p.narrative }}</div>
            </div>
          </div>

          <!-- Estates (屋苑) -->
          <h3 class="section-title">🏘️ Major Housing Estates 主要屋苑</h3>
          <div class="estates-grid">
            <div v-for="estate in selectedReport.estates" :key="estate.name" class="estate-card">
              <div class="estate-header">
                <div>
                  <strong>{{ estate.nameCn || estate.name }}</strong>
                  <span class="estate-en" v-if="estate.nameCn"> {{ estate.name }}</span>
                </div>
                <span class="rec-badge" :class="'rec-' + estate.recommendation">{{ estate.recommendation }}</span>
              </div>
              <div class="estate-area" v-if="estate.area">📍 {{ estate.area }}</div>
              <div class="estate-price" v-if="estate.currentPricePerSqft">
                Current: <strong>${{ estate.currentPricePerSqft?.toLocaleString() }}/sqft</strong>
              </div>
              <div class="estate-preds">
                <span v-for="(val, k) in estate.predictions" :key="k" class="estate-pred" :class="changeClass(val)">
                  {{ formatPeriod(k) }}: {{ val }}
                </span>
              </div>
              <div class="estate-factors" v-if="estate.keyFactors?.length">
                <span v-for="f in estate.keyFactors" :key="f" class="factor-tag">{{ f }}</span>
              </div>
            </div>
          </div>

          <!-- News & Causes -->
          <h3 class="section-title">📰 Major News & Causes</h3>
          <div class="news-list">
            <div v-for="(news, i) in selectedReport.newsCauses" :key="i" class="news-card" :class="'news-' + news.direction">
              <div class="news-header">
                <span class="news-direction">
                  {{ news.direction === 'positive' ? '🟢' : news.direction === 'negative' ? '🔴' : '🟡' }}
                </span>
                <strong>{{ news.headline }}</strong>
              </div>
              <div class="news-meta">
                <span class="news-source">📎 {{ news.source }}</span>
                <span class="news-timeframe">⏱️ {{ news.timeframe }}</span>
              </div>
              <div class="news-impact">{{ news.impact }}</div>
            </div>
          </div>

          <!-- Risks & Opportunities -->
          <div class="ro-row">
            <div class="ro-box opp-box" v-if="selectedReport.opportunities?.length">
              <h4>🟢 Opportunities</h4>
              <ul><li v-for="o in selectedReport.opportunities" :key="o">{{ o }}</li></ul>
            </div>
            <div class="ro-box risk-box" v-if="selectedReport.risks?.length">
              <h4>🔴 Risks</h4>
              <ul><li v-for="r in selectedReport.risks" :key="r">{{ r }}</li></ul>
            </div>
          </div>

          <button class="btn-reanalyze" @click="onDistrictSelect(selectedDistrict)">🔄 Re-analyze</button>
        </div>

        <!-- Selected but no report yet -->
        <div v-if="selectedDistrict && !loadingDistrict && !selectedReport" class="empty-state">
          <div class="empty-icon">⚠️</div>
          <h3>No data for {{ getDistrictName(selectedDistrict) }}</h3>
          <p>Analysis may have failed. Try again.</p>
          <button class="btn-primary" @click="onDistrictSelect(selectedDistrict)">🔄 Retry Analysis</button>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted } from 'vue';
import HKMap from '../components/HKMap.vue';

const districts = ref([]);
const selectedDistrict = ref(null);
const loadingDistrict = ref(null);
const currentStatus = ref(null);
const analyzedDistricts = ref({});
const districtReports = ref({});
let pollInterval = null;

const selectedReport = computed(() => {
  if (!selectedDistrict.value) return null;
  return districtReports.value[selectedDistrict.value] || null;
});

const progressPercent = computed(() => {
  if (!currentStatus.value) return 0;
  const { agentsCompleted, totalAgents } = currentStatus.value;
  if (!totalAgents) return 0;
  return Math.round((agentsCompleted / totalAgents) * 100);
});

const districtsByRegion = computed(() => {
  const regions = {};
  for (const d of districts.value) {
    if (!regions[d.region]) regions[d.region] = [];
    regions[d.region].push(d);
  }
  return Object.entries(regions).map(([region, dists]) => ({ region, districts: dists }));
});

function directionEmoji(dir) {
  if (dir === 'up') return '⬆️';
  if (dir === 'down') return '⬇️';
  if (dir === 'stable') return '➡️';
  return '🔄';
}

function getDistrictName(code) {
  const d = districts.value.find(x => x.code === code);
  return d ? d.name : code;
}

function getDistrictNameCn(code) {
  const d = districts.value.find(x => x.code === code);
  return d ? d.nameCn : '';
}

function formatPeriod(key) {
  if (key === '1year') return '1 Year';
  if (key === '5year') return '5 Years';
  if (key === '10year') return '10 Years';
  return key;
}

function changeClass(val) {
  if (!val) return '';
  if (val.startsWith('+')) return 'change-up';
  if (val.startsWith('-')) return 'change-down';
  return 'change-stable';
}

function districtBtnClass(code) {
  const classes = ['district-btn'];
  if (selectedDistrict.value === code) classes.push('selected');
  if (loadingDistrict.value === code) classes.push('loading');
  if (analyzedDistricts.value[code]) {
    classes.push('analyzed');
    classes.push('dir-' + analyzedDistricts.value[code].direction);
  }
  return classes.join(' ');
}

async function onDistrictSelect(code) {
  if (loadingDistrict.value) return;
  selectedDistrict.value = code;
  loadingDistrict.value = code;
  currentStatus.value = null;

  try {
    const res = await fetch(`/api/district/${code}/analyze`, { method: 'POST' });
    const data = await res.json();
    if (data.simulationId) {
      startPolling(data.simulationId, code);
    }
  } catch (err) {
    loadingDistrict.value = null;
    currentStatus.value = { status: 'failed', error: err.message, currentPhase: 'Error' };
  }
}

function startPolling(simulationId, districtCode) {
  if (pollInterval) clearInterval(pollInterval);
  pollInterval = setInterval(async () => {
    try {
      const res = await fetch(`/api/simulation/${simulationId}/status`);
      const data = await res.json();
      currentStatus.value = data;

      if (data.status === 'completed') {
        clearInterval(pollInterval);
        pollInterval = null;
        await loadDistrictReport(simulationId, districtCode);
        loadingDistrict.value = null;
      } else if (data.status === 'failed') {
        clearInterval(pollInterval);
        pollInterval = null;
        loadingDistrict.value = null;
      }
    } catch {
      // retry
    }
  }, 2000);
}

async function loadDistrictReport(simulationId, districtCode) {
  try {
    const res = await fetch(`/api/simulation/${simulationId}/report`);
    const data = await res.json();
    if (data.report) {
      districtReports.value[districtCode] = data.report;
      analyzedDistricts.value[districtCode] = {
        direction: data.report.direction || 'stable',
        simulationId,
      };
    }
  } catch {
    // report load error
  }
}

async function loadDistricts() {
  try {
    const res = await fetch('/api/districts');
    districts.value = await res.json();
  } catch {
    // load error
  }
}

onMounted(() => {
  loadDistricts();
});

onUnmounted(() => {
  if (pollInterval) clearInterval(pollInterval);
});
</script>

<style scoped>
